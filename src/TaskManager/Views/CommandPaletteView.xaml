<UserControl x:Class="TaskManager.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskManager.Controls"
             xmlns:vm="clr-namespace:TaskManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CommandPaletteViewModel}">
    <Grid Background="{StaticResource Overlay}" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border Width="620" VerticalAlignment="Top" Margin="0,80,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" />
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
                    <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" FontSize="15" Tag="{Binding Placeholder}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <ListBox x:Name="Results" Style="{StaticResource BareListBox}" ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}" MaxHeight="420" Padding="6" Focusable="False"
                         VirtualizingPanel.IsVirtualizing="True" PreviewMouseLeftButtonUp="Results_MouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PaletteItem}">
                            <DockPanel Height="34" Margin="10,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyHint}" VerticalAlignment="Center"
                                        Visibility="{Binding Shortcut, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="{StaticResource Text2}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{StaticResource Text3}" FontSize="12"
                                           VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock DockPanel.Dock="Right" Text="✓" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding IsChecked, Converter={StaticResource Visible}}" />
                                <Grid Width="22" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <c:StatusGlyph Status="{Binding Status}" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" HorizontalAlignment="Left" />
                                    <c:PriorityGlyph Priority="{Binding Priority}" Visibility="{Binding HasPriority, Converter={StaticResource Visible}}" HorizontalAlignment="Left" />
                                    <Border Width="10" Height="10" CornerRadius="3" HorizontalAlignment="Left" Margin="2,0,0,0"
                                            Background="{Binding Color, Converter={StaticResource HexBrush}}"
                                            Visibility="{Binding HasColor, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Glyph}" FontSize="12" HorizontalAlignment="Left"
                                               Visibility="{Binding HasGlyph, Converter={StaticResource Visible}}" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
