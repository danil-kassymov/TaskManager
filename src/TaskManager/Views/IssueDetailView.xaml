<UserControl x:Class="TaskManager.Views.IssueDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskManager.Controls"
             xmlns:vm="clr-namespace:TaskManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:IssueDetailViewModel}"
             Background="{StaticResource Panel}">
    <UserControl.Resources>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8,8,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Command="{Binding CopyBranchCommand}" ToolTip="Копировать имя git-ветки">
                        <TextBlock Text="⎇ ветка" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Delete_Click" ToolTip="Удалить (Delete)">
                        <TextBlock Text="🗑" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Close_Click" ToolTip="Закрыть (Esc)">
                        <TextBlock Text="✕" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Command="{Binding CopyKeyCommand}" ToolTip="Копировать ID и заголовок" Padding="4,2">
                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource Text2}" FontWeight="SemiBold" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding OpenParentCommand}" Padding="4,2" Margin="4,0,0,0"
                            Visibility="{Binding Parent, Converter={StaticResource Visible}}" ToolTip="Открыть родительскую задачу">
                        <TextBlock Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" MaxWidth="260">
                            <Run Text="↑" /> <Run Text="{Binding Parent.Key, Mode=OneWay}" /> <Run Text="{Binding Parent.Title, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="32,22,32,32">
            <!-- Readable line length on wide screens: the content column is capped and centered -->
            <StackPanel MaxWidth="900">
                <!-- Title -->
                <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}" TextOptions.TextFormattingMode="Ideal" FontWeight="SemiBold"
                         TextWrapping="Wrap" AcceptsReturn="False" Tag="Заголовок задачи"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" KeyDown="TitleBox_KeyDown" />

                <!-- Properties -->
                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6" c:MenuButton.OpenOnClick="True" ToolTip="Статус (S)">
                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusItem}" />
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Statuses}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Command" Value="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="HeaderTemplate" Value="{StaticResource StatusItem}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6" c:MenuButton.OpenOnClick="True" ToolTip="Приоритет (P, 1–4)">
                        <ContentPresenter Content="{Binding Priority}" ContentTemplate="{StaticResource PriorityItem}" />
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Priorities}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Command" Value="{Binding DataContext.SetPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="HeaderTemplate" Value="{StaticResource PriorityItem}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6" c:MenuButton.OpenOnClick="True" ToolTip="Проект (M)">
                        <ContentPresenter Content="{Binding Project}" ContentTemplate="{StaticResource ProjectItem}" />
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Projects}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Command" Value="{Binding DataContext.MoveToProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="HeaderTemplate" Value="{StaticResource ProjectItem}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6" c:MenuButton.OpenOnClick="True" ToolTip="Метки (L)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷 Метки" Foreground="{StaticResource Text2}"
                                       Visibility="{Binding SelectedLabels.Count, Converter={StaticResource Visible}, ConverterParameter='!'}" />
                            <ItemsControl ItemsSource="{Binding SelectedLabels}" ItemTemplate="{StaticResource LabelPill}" Margin="0,0,-4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding LabelChoices}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Command" Value="{Binding DataContext.ToggleLabelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding Label}" />
                                        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                        <Setter Property="StaysOpenOnClick" Value="True" />
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                 Fill="{Binding DataContext.Label.Color, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Text="{Binding DataContext.Label.Name, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>

                <!-- Description -->
                <DockPanel Margin="0,18,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding EditCommand}" Padding="6,1" Click="Edit_Click"
                                Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter='!'}">
                            <TextBlock Text="Изменить  E" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding PreviewCommand}" Padding="6,1"
                                Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                            <TextBlock Text="Готово  Esc" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Описание" Style="{StaticResource PropLabel}" />
                </DockPanel>

                <TextBox x:Name="Editor" Style="{StaticResource InputTextBox}" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="Wrap" MinHeight="140" FontFamily="{StaticResource MonoFont}" TextOptions.TextFormattingMode="Ideal" Padding="14,10"
                         Tag="Описание в Markdown. Ctrl+V — вставить скриншот, перетащи картинку, выдели текст и вставь URL для ссылки."
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" SpellCheck.IsEnabled="False"
                         Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"
                         LostKeyboardFocus="Editor_LostFocus" KeyDown="Editor_KeyDown" />

                <Border x:Name="PreviewHost" Background="Transparent" Cursor="IBeam" MinHeight="24"
                        Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter='!'}"
                        MouseLeftButtonDown="Preview_MouseDown" ToolTip="Двойной клик — редактировать">
                    <RichTextBox x:Name="Preview" TextOptions.TextFormattingMode="Ideal" IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent"
                                 BorderThickness="0" Padding="0" Foreground="{StaticResource Text}"
                                 VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Cursor="Arrow">
                        <RichTextBox.Template>
                            <ControlTemplate TargetType="RichTextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" />
                            </ControlTemplate>
                        </RichTextBox.Template>
                    </RichTextBox>
                </Border>

                <!-- Subtasks -->
                <DockPanel Margin="0,22,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubtaskProgress}" Style="{StaticResource PropLabel}" />
                    <TextBlock Text="Подзадачи" Style="{StaticResource PropLabel}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Subtasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IssueRow}">
                            <Border x:Name="Row" CornerRadius="5" Padding="4,0,8,0" Height="32" Background="Transparent">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Padding="4"
                                            Command="{Binding DataContext.ToggleSubtaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Отметить выполненной">
                                        <c:StatusGlyph Status="{Binding Status}" />
                                    </Button>
                                    <c:PriorityGlyph DockPanel.Dock="Right" Priority="{Binding Priority}" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Foreground="{StaticResource Text3}" FontSize="12"
                                               VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <Button Style="{StaticResource FlatButton}" Padding="2,0" Foreground="{StaticResource Text}"
                                            Command="{Binding DataContext.OpenSubtaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" FontSize="13.5">
                                        <TextBlock x:Name="SubTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                    <Setter TargetName="SubTitle" Property="Foreground" Value="{StaticResource Text3}" />
                                    <Setter TargetName="SubTitle" Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="SubtaskBox" Style="{StaticResource BareTextBox}" Margin="10,6,0,0" Padding="0,4"
                         Tag="＋ Добавить подзадачу (Enter)" Text="{Binding NewSubtask, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SubtaskBox_KeyDown" />

                <!-- Knowledge base links -->
                <DockPanel Margin="0,22,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,1" Command="{Binding LinkKbCommand}"
                            ToolTip="Привязать запись из базы данных">
                        <TextBlock Text="＋ Привязать" FontSize="12" />
                    </Button>
                    <TextBlock Text="Записи из базы" Style="{StaticResource PropLabel}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding KbLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="5" Padding="4,0,4,0" Height="32" Background="Transparent">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2" ToolTip="Отвязать"
                                            Command="{Binding DataContext.UnlinkKbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" Padding="4,0" Foreground="{StaticResource Text}"
                                            Command="{Binding DataContext.OpenKbLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Path}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LinkTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Foreground="{StaticResource Text3}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Folder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                    <Setter TargetName="LinkTitle" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="LinkTitle" Property="Foreground" Value="#EB5757" />
                                    <Setter TargetName="Row" Property="ToolTip" Value="Файл не найден — переименован или удалён вне приложения" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Набери [[ в описании, чтобы вставить ссылку на запись" Foreground="{StaticResource Text3}" FontSize="12"
                           Margin="10,2,0,0" Visibility="{Binding KbLinks.Count, Converter={StaticResource Visible}, ConverterParameter='!'}" />

                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,28,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
