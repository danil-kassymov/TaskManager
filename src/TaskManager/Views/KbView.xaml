<UserControl x:Class="TaskManager.Views.KbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TaskManager.Controls"
             xmlns:vm="clr-namespace:TaskManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:KbViewModel}">
    <UserControl.Resources>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Colored tag chip; right click changes the color -->
        <DataTemplate x:Key="TagChipTemplate" DataType="{x:Type vm:TagChip}">
            <Border x:Name="Chip" CornerRadius="9" Padding="7,1,8,2" Margin="0,0,5,5" BorderThickness="1"
                    BorderBrush="{Binding Color, Converter={StaticResource HexBrush}}" Background="Transparent">
                <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{Binding Color, Converter={StaticResource HexBrush}}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="#22FFFFFF" />
                    <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TagDots">
            <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="7" Height="7" Margin="2,0" Fill="{Binding Color, Converter={StaticResource HexBrush}}" ToolTip="{Binding Display}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="Новая запись здесь" Click="NodeNewEntry_Click" />
            <MenuItem Header="Новая папка здесь…" Click="NodeNewFolder_Click" />
            <Separator />
            <MenuItem Header="Переименовать…" Click="NodeRename_Click" />
            <MenuItem Header="Показать в проводнике" Click="NodeReveal_Click" />
            <Separator />
            <MenuItem Header="Удалить в корзину" Click="NodeDelete_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="220" MaxWidth="600" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ============ Tree pane ============ -->
        <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Padding="6,2" ToolTip="Новая запись (C)"
                                Command="{Binding NewEntryCommand}" CommandParameter="{x:Null}">
                            <TextBlock Text="＋ Запись" />
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="6,2" ToolTip="Новая папка" Click="NewFolder_Click">
                            <TextBlock Text="＋ Папка" />
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="6,2" ToolTip="Открыть папку в проводнике" Click="RevealRoot_Click">
                            <TextBlock Text="↗" />
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource Text3}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                <TextBox x:Name="FilterBox" Style="{StaticResource InputTextBox}" Padding="8,4" Tag="Поиск по записям…"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagChip}">
                            <Button Style="{StaticResource FlatButton}" Padding="0" ToolTip="{Binding Count, StringFormat='Записей: {0}. Правый клик — цвет'}"
                                    Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ContextMenuOpening="TagMenu_Opening">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TagChipTemplate}" />
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid>
                <!-- Folder tree -->
                <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0" Padding="4,0,4,20"
                          SelectedItemChanged="Tree_SelectedItemChanged" AllowDrop="True" Drop="Tree_Drop" DragOver="Tree_DragOver"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseDown" PreviewMouseMove="Tree_PreviewMouseMove"
                          Visibility="{Binding IsFiltering, Converter={StaticResource Visible}, ConverterParameter='!'}">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Новая запись" Click="RootNewEntry_Click" />
                            <MenuItem Header="Новая папка…" Click="NewFolder_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:KbNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock x:Name="Icon" Text="📄" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TagDots}" />
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter TargetName="Icon" Property="Text" Value="📁" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Search / tag results -->
                <ListBox x:Name="ResultList" Style="{StaticResource BareListBox}" ItemsSource="{Binding Results}" Padding="6,0,6,20"
                         SelectionChanged="Results_SelectionChanged"
                         Visibility="{Binding IsFiltering, Converter={StaticResource Visible}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KbNode}">
                            <StackPanel Margin="10,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Modified}" Foreground="{StaticResource Text3}" FontSize="11.5" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Text3}" FontSize="11.5" />
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TagDots}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" IsHitTestVisible="False"
                            Visibility="{Binding SourceMissing, Converter={StaticResource Visible}}">
                    <TextBlock Text="Папка не найдена" HorizontalAlignment="Center" Foreground="#EB5757" FontSize="14" />
                    <TextBlock Text="Проверь путь или убери источник из списка" HorizontalAlignment="Center" Foreground="{StaticResource Text3}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" />

        <!-- ============ Entry pane ============ -->
        <Grid Grid.Column="2" Background="{StaticResource Panel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding Entry, Converter={StaticResource Visible}, ConverterParameter='!'}">
                <TextBlock Text="Выбери запись слева" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource Text2}" />
                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text3}">
                    <Run Text="{Binding EntryCount, Mode=OneWay}" /><Run Text=" записей · C — новая запись" />
                </TextBlock>
            </StackPanel>

            <DockPanel DataContext="{Binding Entry}" Visibility="{Binding Converter={StaticResource Visible}}">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8,8,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Command="{Binding CopyLinkCommand}" ToolTip="Копировать markdown-ссылку на запись">
                                <TextBlock Text="🔗 ссылка" />
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="EntryReveal_Click" ToolTip="Показать в проводнике">
                                <TextBlock Text="↗" />
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="EntryDelete_Click" ToolTip="Удалить в корзину">
                                <TextBlock Text="🗑" />
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="EntryClose_Click" ToolTip="Закрыть (Esc)">
                                <TextBlock Text="✕" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Breadcrumb}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="28,18,28,24">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                        <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}" FontSize="22" FontWeight="SemiBold"
                                 TextWrapping="Wrap" Tag="Название записи" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus" ToolTip="Название = имя файла" />

                        <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChipTemplate}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Linked issues -->
                        <DockPanel Margin="0,12,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,1" Command="{Binding LinkIssueCommand}">
                                <TextBlock Text="＋ Привязать к задаче" FontSize="12" />
                            </Button>
                            <TextBlock Text="Связанные задачи" Style="{StaticResource PropLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding LinkedIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:IssueRow}">
                                    <Border x:Name="Row" CornerRadius="5" Padding="4,0" Height="30" Background="Transparent">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2" ToolTip="Отвязать"
                                                    Command="{Binding DataContext.UnlinkIssueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="✕" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource FlatButton}" Padding="4,0" Foreground="{StaticResource Text}"
                                                    Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:StatusGlyph Status="{Binding Status}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Content -->
                        <DockPanel Margin="0,16,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource FlatButton}" Padding="6,1" Click="Edit_Click"
                                        Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter='!'}">
                                    <TextBlock Text="Изменить  E" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding PreviewCommand}" Padding="6,1"
                                        Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Готово  Esc" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Содержимое" Style="{StaticResource PropLabel}" />
                        </DockPanel>

                        <TextBox x:Name="Editor" Style="{StaticResource InputTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="240" FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="10,8"
                                 Tag="Markdown. #теги прямо в тексте, Ctrl+V — вставить скриншот, ссылки на задачи вида TM-12."
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" SpellCheck.IsEnabled="False"
                                 Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"
                                 LostKeyboardFocus="Editor_LostFocus" KeyDown="Editor_KeyDown" />

                        <Border Background="Transparent" MinHeight="24" MouseLeftButtonDown="Preview_MouseDown" ToolTip="Двойной клик — редактировать"
                                Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter='!'}">
                            <RichTextBox x:Name="Preview" IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent"
                                         BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Cursor="Arrow">
                                <RichTextBox.Template>
                                    <ControlTemplate TargetType="RichTextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" />
                                    </ControlTemplate>
                                </RichTextBox.Template>
                            </RichTextBox>
                        </Border>

                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,24,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
